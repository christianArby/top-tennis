// Firestore-regler för tennisdagboken — deployas med
//   firebase deploy --only firestore:rules --account christian.arby@gmail.com
//
// Enanvändarapp utan inloggning: läsning är öppen, och skrivning begränsas
// till kända kollektioner med strikta dokument-id så att ingen kan fylla
// databasen med skräp.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Dagboksposter: id = datum, ev. löpnummer vid flera pass samma dag.
    match /diary/{docId} {
      allow read: if true;
      allow write: if docId.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9](-[2-9])?$');
    }
    // Racketar: a | b
    match /rackets/{docId} {
      allow read: if true;
      allow write: if docId.matches('^[a-d]$');
    }
    // Kommande pass: id = datum + tid, t.ex. 2026-11-08-1700.
    match /upcoming/{docId} {
      allow read: if true;
      allow write: if docId.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]-[0-2][0-9][0-5][0-9]$');
    }
    // Höstplanens arkiv (vecka:slot).
    match /session_log/{docId} {
      allow read: if true;
      allow write: if docId.matches('^([1-9]|1[0-2]):[0-3]$');
    }
  }
}
